---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Cover from '../../components/Cover.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Share from '../../components/Share.astro';
import { ARTICLE_TYPES, SITE } from '../../site.config';
import { getPublished, url, formatDate, slugifyTag, readingTime, youtubeId, youtubeThumb, type Article } from '../../lib/utils';

export async function getStaticPaths() {
  const articles = await getPublished();
  return articles.map((a) => ({ params: { slug: a.id }, props: { article: a, all: articles } }));
}
const { article, all } = Astro.props as { article: Article; all: Article[] };
const d = article.data;
const t = ARTICLE_TYPES[d.type];
const { Content } = await render(article);
const related = all
  .filter((a) => a.id !== article.id && a.data.tags.some((tg) => d.tags.includes(tg)))
  .slice(0, 3);
const yt = youtubeId(d.youtube);
const ytThumb = youtubeThumb(d.youtube);
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const disclosures: Record<string, string> = {
  gyujtott: 'Ez a hírösszefoglaló nyilvánosan elérhető források alapján, nyelvi modell segítségével készült. Megjelenés előtt szerkesztőnk átolvasta, ellenőrizte és jóváhagyta.',
  video: 'Ez a videóajánló a videó címe és leírása alapján, nyelvi modell segítségével készült. Megjelenés előtt szerkesztőnk átolvasta, ellenőrizte és jóváhagyta.',
  forditas: 'Ez a fordítás nyelvi modell segítségével készült, az eredeti szerző vagy kiadó engedélyével. Megjelenés előtt szerkesztőnk átolvasta, ellenőrizte és jóváhagyta.',
};
const disclosure = disclosures[d.type];
const sourceLabel = d.type === 'forditas' ? 'Az eredeti cikk' : 'Források';
---
<Base title={d.title} description={d.description} image={d.image || ytThumb} type="article" published={d.date}>
  {!d.published && <div class="draft-banner">TERVEZET – ez a cikk még nincs jóváhagyva, a nyilvános oldalon nem látszik.</div>}
  <article class="article">
    <header>
      <div class="row">
        <span class="badge" style={`background:${t.color};color:${t.text}`}>{t.label}</span>
        {d.tags.map((tg) => <a class="tag" href={url(`/cimkek/${slugifyTag(tg)}/`)}>{tg}</a>)}
      </div>
      <h1>{d.title}</h1>
      <p class="lede">{d.description}</p>
      <p class="meta">
        {d.author ?? SITE.defaultAuthor} · <time datetime={d.date.toISOString()}>{formatDate(d.date)}</time> · {readingTime(article.body ?? '')} perc olvasás
      </p>
    </header>

    {yt && (
      <div class="video" data-yt={yt} data-title={d.title}>
        <button type="button" class="video-play" aria-label="Videó lejátszása" style={ytThumb ? `background-image: linear-gradient(rgba(0,0,0,.35), rgba(0,0,0,.55)), url(${url(ytThumb)}); background-size: cover; background-position: center;` : undefined}>
          <span class="play-icon" aria-hidden="true">▶</span>
          <span class="play-text">Videó lejátszása</span>
          <span class="play-note">A lejátszással a YouTube (Google) tartalma töltődik be, amely sütiket használhat.</span>
        </button>
      </div>
    )}

    {!yt && d.image && (
      <figure>
        <Cover image={d.image} alt={d.imageAlt} type={d.type} />
        {(d.imageAlt || d.imageCredit) && (
          <figcaption class="meta">{d.imageAlt}{d.imageAlt && d.imageCredit && ' · '}{d.imageCredit && <span class="credit">{d.imageCredit}</span>}</figcaption>
        )}
      </figure>
    )}

    <div class="prose"><Content /></div>

    <Share url={pageUrl} title={d.title} />

    {disclosure && (
      <p class="disclosure">{disclosure} <a href={url('/rolunk/#hogyan-készülnek-a-cikkeink')}>Hogyan készülnek a cikkeink?</a></p>
    )}

    {d.sources.length > 0 && (
      <aside class="sources">
        <h2>{sourceLabel}</h2>
        {d.type === 'forditas' && <p class="meta">Ez a cikk az alábbi írás magyar fordítása, a forrás feltüntetésével.</p>}
        <ul>
          {d.sources.map((s) => <li><a href={s.url} rel="noopener" target="_blank" data-goatcounter-click={`forras: ${s.url}`} data-goatcounter-title={`Forrás – ${d.title}`}>{s.name}</a></li>)}
        </ul>
      </aside>
    )}
  </article>

  {related.length > 0 && (
    <section class="related">
      <h2>Kapcsolódó hírek</h2>
      <div class="grid">{related.map((a) => <ArticleCard article={a} />)}</div>
    </section>
  )}
</Base>
<script>
  document.querySelectorAll<HTMLElement>('.video[data-yt]').forEach((box) => {
    box.querySelector('button')?.addEventListener('click', () => {
      const f = document.createElement('iframe');
      f.src = `https://www.youtube-nocookie.com/embed/${box.dataset.yt}?autoplay=1`;
      f.title = box.dataset.title || 'YouTube-videó';
      f.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      f.allowFullscreen = true;
      box.replaceChildren(f);
    });
  });
</script>
<style>
  .article { max-width: 760px; margin: 0 auto; }
  .row { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
  .row .tag { margin: 0; }
  h1 { font-size: clamp(2rem, 4.5vw, 3rem); margin: 18px 0 12px; }
  .lede { font-size: 1.2rem; color: var(--c-muted); margin: 0 0 14px; }
  figure { margin: 28px 0; }
  figcaption { margin-top: 8px; }
  .credit { font-style: italic; }
  .video { margin: 28px 0; aspect-ratio: 16 / 9; border-radius: var(--radius); overflow: hidden; background: #000; }
  .video :global(iframe) { width: 100%; height: 100%; border: 0; display: block; }
  .video-play { width: 100%; height: 100%; border: 0; cursor: pointer; color: #fff; background: #1d2528;
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px; padding: 20px; font: inherit; }
  .video-play:hover .play-icon { background: var(--c-accent); }
  .play-icon { width: 72px; height: 72px; border-radius: 50%; background: rgba(255,255,255,.15); display: grid; place-items: center; font-size: 1.8rem; padding-left: 6px; transition: background .15s; }
  .play-text { font-weight: 650; font-size: 1.05rem; }
  .play-note { font-size: 0.8rem; opacity: .7; max-width: 46ch; text-align: center; }
  .prose { margin-top: 28px; font-size: 1.06rem; }
  .disclosure { margin-top: 36px; font-size: 0.85rem; color: var(--c-muted); padding: 12px 16px; border: 1px dashed var(--c-line); border-radius: var(--radius); }
  .disclosure a { color: var(--c-link); font-weight: 600; margin-left: 4px; white-space: nowrap; }
  .sources { margin-top: 40px; padding: 18px 22px; background: var(--c-card); border: 1px solid var(--c-line); border-left: 4px solid var(--c-accent); border-radius: var(--radius); }
  .sources h2 { font-size: 1rem; margin: 0 0 6px; font-family: var(--f-body); text-transform: uppercase; letter-spacing: 0.08em; }
  .sources ul { margin: 6px 0 0; padding-left: 1.2em; }
  .sources a { color: var(--c-link); word-break: break-word; }
  .related { margin-top: 64px; border-top: 2px solid var(--c-ink); padding-top: 20px; }
  .related h2 { font-size: 1.3rem; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 28px; }
</style>
