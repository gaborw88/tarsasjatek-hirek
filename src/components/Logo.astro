---
// Egyszerű kocka-logó (saját rajz)
const { size = 38 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 40 40" aria-hidden="true">
  <rect x="3" y="3" width="34" height="34" rx="8" fill="var(--c-accent)" />
  <circle cx="12" cy="12" r="3.2" fill="#fff" />
  <circle cx="28" cy="12" r="3.2" fill="#fff" />
  <circle cx="20" cy="20" r="3.2" fill="var(--c-mustard)" />
  <circle cx="12" cy="28" r="3.2" fill="#fff" />
  <circle cx="28" cy="28" r="3.2" fill="#fff" />
</svg>
